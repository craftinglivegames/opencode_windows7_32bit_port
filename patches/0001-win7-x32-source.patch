diff --git a/packages/opencode/src/cli/cmd/bun-compat.ts b/packages/opencode/src/cli/cmd/bun-compat.ts
new file mode 100644
index 0000000..6176170
--- /dev/null
+++ b/packages/opencode/src/cli/cmd/bun-compat.ts
@@ -0,0 +1,49 @@
+// Bun API compatibility shim for the Node port (Win7 x86).
+// Replaces the Bun.* runtime calls that survived the build: Bun.stringWidth,
+// Bun.stdin.text(). Keep the semantics close to Bun's so the callers don't
+// need to know which runtime they are on.
+
+const ansi = new RegExp("\\x1b\\[[0-9;]*[A-Za-z]|\\x1b\\][^\x07]*\x07|\\x1b\\(B", "g")
+
+// Terminal display width of a string: ANSI escapes are zero-width, wide
+// (East Asian) code points count as 2, combining marks as 0. Close enough
+// to Bun.stringWidth for prompt rendering on the run/tui CLI paths.
+export function stringWidth(text: string): number {
+  let width = 0
+  for (const ch of text.replace(ansi, "")) {
+    const code = ch.codePointAt(0)!
+    if (code === 0) continue
+    if (code < 32 || (code >= 0x7f && code < 0xa0)) continue
+    if (code >= 0x300 && code <= 0x36f) continue
+    if (
+      (code >= 0x1100 && code <= 0x115f) ||
+      code === 0x2329 ||
+      code === 0x232a ||
+      (code >= 0x2e80 && code <= 0xa4cf && code !== 0x303f) ||
+      (code >= 0xac00 && code <= 0xd7a3) ||
+      (code >= 0xf900 && code <= 0xfaff) ||
+      (code >= 0xfe30 && code <= 0xfe6f) ||
+      (code >= 0xff00 && code <= 0xff60) ||
+      (code >= 0xffe0 && code <= 0xffe6) ||
+      (code >= 0x1f300 && code <= 0x1f64f) ||
+      (code >= 0x1f900 && code <= 0x1f9ff) ||
+      (code >= 0x20000 && code <= 0x3fffd)
+    ) {
+      width += 2
+      continue
+    }
+    width += 1
+  }
+  return width
+}
+
+// Replacement for `await Bun.stdin.text()`: drain piped stdin as utf8.
+// Resolves to "" when stdin is a TTY or already closed.
+export async function readStdinText(): Promise<string> {
+  if (process.stdin.isTTY) return ""
+  const chunks: Buffer[] = []
+  for await (const chunk of process.stdin) {
+    chunks.push(chunk as Buffer)
+  }
+  return Buffer.concat(chunks).toString("utf8")
+}
